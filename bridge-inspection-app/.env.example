# Local demonstration: login buttons are available only on a loopback-bound server.
HOST=127.0.0.1
PORT=8770
DEMO_MODE=true
WEBODM_URL=http://localhost:8000/dashboard/
# For a private server deployment set DEMO_MODE=false and set strong passwords.
# ADMIN_EMAIL=reviewer@example.com
# ADMIN_PASSWORD=
# INSPECTOR_EMAIL=inspector@example.com
# INSPECTOR_PASSWORD=
# PUBLIC_ORIGIN=https://bridge.example.com
# COOKIE_SECURE=true
